# Dev only: target of the Vite proxy for /api (the backend).
VITE_PROXY_TARGET=http://localhost:8080

# Optional: API base URL. The default (/api/v1) works with the dev proxy and with a reverse proxy in production.
# VITE_API_BASE=/api/v1

# Optional: show the demo users on the login screen outside development (public demos only).
# VITE_SHOW_DEMO_USERS=true

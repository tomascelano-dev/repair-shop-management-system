# Copiar a .env (no se versiona) y completar. Los secretos se generan en el servidor (ver README.md).

# Dominio público (el proxy del host lo publica con HTTPS hacia WEB_PORT).
DOMAIN=nuevo.techxto.ar
WEB_PORT=8086

# Secretos: generalos con openssl, no los inventes.
DB_PASSWORD=
JWT_KEY=
# Guardala también en tu gestor de contraseñas: sin ella, una copia de la base no puede descifrar los tokens
# de Mercado Pago ni los certificados ARCA.
MASTER_KEY=

# Email (opcional; sin esto los links de invitación y de contraseña se copian desde la app).
EMAIL_PROVIDER=None
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=RepairShop

# WhatsApp automático (opcional: None | Twilio | Meta). Sin esto, la app abre WhatsApp con el mensaje armado.
WHATSAPP_PROVIDER=None
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_TEMPLATE_NAME=

# Sugerencias de diagnóstico con Claude (opcional: None | Anthropic).
AI_PROVIDER=None
ANTHROPIC_API_KEY=

# Suscripciones de los talleres (ver README → Suscripciones). Se cobran SOLO con Mercado Pago.
# Dejalo en false hasta tener configurada la cuenta de Mercado Pago de al menos un país.
SIGNUP_ENABLED=false
# Datos que muestran Términos, Privacidad y Reembolsos.
CONTACT_EMAIL=
LEGAL_NAME=
TRIAL_DAYS=14

# Argentina: tu cuenta de Mercado Pago de la plataforma (no la de un taller). Precios finales en pesos.
MP_BILLING_ACCESS_TOKEN=
MP_BILLING_WEBHOOK_SECRET=
PRICE_ARS_BASIC=29900
PRICE_ARS_STANDARD=44900
PRICE_ARS_PRO=74900

# Otros países de Mercado Pago (opcional). Cada país necesita SU cuenta de Mercado Pago de ese país:
# se habilita para alta y cobro solo con token, secreto y los tres precios en su moneda.
# Webhook de cada uno: https://<DOMAIN>/api/v1/billing/webhooks/mercadopago/<código> (ej. .../mercadopago/mx).
# Brasil (BRL), Chile (CLP), Colombia (COP), México (MXN), Perú (PEN), Uruguay (UYU):
MP_BILLING_BR_ACCESS_TOKEN=
MP_BILLING_BR_WEBHOOK_SECRET=
PRICE_BRL_BASIC=0
PRICE_BRL_STANDARD=0
PRICE_BRL_PRO=0
MP_BILLING_CL_ACCESS_TOKEN=
MP_BILLING_CL_WEBHOOK_SECRET=
PRICE_CLP_BASIC=0
PRICE_CLP_STANDARD=0
PRICE_CLP_PRO=0
MP_BILLING_CO_ACCESS_TOKEN=
MP_BILLING_CO_WEBHOOK_SECRET=
PRICE_COP_BASIC=0
PRICE_COP_STANDARD=0
PRICE_COP_PRO=0
MP_BILLING_MX_ACCESS_TOKEN=
MP_BILLING_MX_WEBHOOK_SECRET=
PRICE_MXN_BASIC=0
PRICE_MXN_STANDARD=0
PRICE_MXN_PRO=0
MP_BILLING_PE_ACCESS_TOKEN=
MP_BILLING_PE_WEBHOOK_SECRET=
PRICE_PEN_BASIC=0
PRICE_PEN_STANDARD=0
PRICE_PEN_PRO=0
MP_BILLING_UY_ACCESS_TOKEN=
MP_BILLING_UY_WEBHOOK_SECRET=
PRICE_UYU_BASIC=0
PRICE_UYU_STANDARD=0
PRICE_UYU_PRO=0

# Medición de anuncios (opcional; lo que quede vacío no se carga). Ver README → Anuncios.
# Google Analytics 4: ID de medición (G-...).
GA4_ID=
# Google Ads: ID de la etiqueta (AW-...) y la etiqueta de cada conversión (lo que va después de la barra en send_to).
GOOGLE_ADS_ID=
GOOGLE_ADS_SIGNUP_LABEL=
GOOGLE_ADS_PURCHASE_LABEL=
# Meta: ID del píxel y token de la API de conversiones (secreto).
META_PIXEL_ID=
META_CAPI_TOKEN=
# Solo mientras probás en Administrador de eventos → Probar eventos; después dejalo vacío.
META_TEST_EVENT_CODE=

# Copias de seguridad.
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=6
RCLONE_REMOTE=

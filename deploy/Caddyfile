# Web container: serves the React build and forwards the API. It listens on plain HTTP; TLS is terminated by
# the reverse proxy in front (Caddy on the host + Cloudflare). SITE_ROOT and API_UPSTREAM exist for local tests.
{
	admin off
	auto_https off
	servers {
		# Requests arrive from the host proxy through Docker's network: trust the X-Forwarded-For it sends and
		# take the right-most address that is not a trusted proxy as the client IP.
		# Security audit 2026-11-23 (M-03): Cloudflare's edge is a proxy too. Without its ranges here the right-most
		# untrusted address was Cloudflare's, so every visitor behind the same edge shared the per-IP limits and the
		# stored IPs (quote approvals, signups) were Cloudflare's. Ranges from https://www.cloudflare.com/ips/
		# (check them again from time to time; a missing range only falls back to the old behaviour for that edge).
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	encode zstd gzip

	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080} {
			# One clean entry for the API (it trusts exactly one proxy hop for per-IP rate limits).
			header_up X-Forwarded-For {client_ip}
			# The public site is always HTTPS (secure session cookie, HSTS).
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		root * {$SITE_ROOT:/srv}
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			# Camera only for this site: barcode scanning at the point of sale.
			Permissions-Policy "camera=(self), microphone=(), geolocation=()"
			Strict-Transport-Security "max-age=31536000"
			-Server
		}
		# Hashed build files never change; everything else (index.html, sw.js) is revalidated so a deploy
		# is picked up on the next visit.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		# The bare domain is the product's public face: browsers without a session (visitors, crawlers, payment
		# provider reviewers) get the pre-rendered landing page; signed-in browsers (rs_app cookie) get the app.
		@public_root {
			path /
			not header_regexp Cookie (^|;\s*)rs_app=1
		}
		rewrite @public_root /home.html
		@english_root path /en /en/
		rewrite @english_root /en.html
		# The public pages are pre-rendered at build time (precios.html, terminos.html...) so they have content
		# without JavaScript; every other route gets the SPA shell.
		try_files {path} {path}.html /index.html
		# Fill in the contact email and seller name from the container's environment (see frontend/scripts/prerender.mjs).
		# GET only: Caddy answers HEAD on a templated file with an empty body (Content-Length: 0), which site
		# checkers read as a blank page; HEAD gets the plain file instead.
		# The same fills PUBLIC_ORIGIN (https://<domain>) into canonical/hreflang/Open Graph tags, sitemap.xml and robots.txt.
		@prerendered {
			path /home.html /precios.html /terminos.html /privacidad.html /reembolsos.html /en.html /en/pricing.html /en/terms.html /en/privacy.html /en/refunds.html /sitemap.xml /robots.txt
			# Long-tail guides (frontend/src/features/public/guides.ts).
			path /sistema-servicio-tecnico-celulares.html /orden-de-reparacion-online.html /control-de-stock-de-repuestos.html /factura-electronica-servicio-tecnico.html /plantilla-orden-de-servicio-tecnico.html /sistema-vs-excel-servicio-tecnico.html
			method GET
		}
		templates @prerendered {
			mime text/html text/plain text/xml application/xml
			between [[ ]]
		}
		file_server
	}
}

# Copy to .env (gitignored) and fill the values. Used by docker-compose.prod.yml:
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up --build -d

# ===== Database =====
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
CONNECTIONSTRINGS__REPAIRSHOPDB=Host=postgres;Port=5432;Database=repairshop;Username=postgres;Password=CHANGE_ME_LONG_RANDOM_PASSWORD

# ===== Security =====
# JWT signing key: at least 32 bytes (e.g. `openssl rand -base64 48`).
JWT__KEY=CHANGE_ME
JWT__ISSUER=RepairShop
JWT__AUDIENCE=RepairShop
# Encrypts the key ring that protects shop secrets (Mercado Pago tokens, ARCA certificates): `openssl rand -base64 32`.
DATAPROTECTION_MASTERKEY=CHANGE_ME

# ===== Public URLs and hosts =====
# Web app URL (tracking links, QR codes, invitations) and API URL (Mercado Pago webhooks).
APP_FRONTEND_URL=https://app.your-domain.example
APP_PUBLIC_API_URL=https://api.your-domain.example
# CORS: the web app origin(s).
CORS_ALLOWED_ORIGIN_0=https://app.your-domain.example
# Host filtering: your API domain(s), separated by ';'.
ALLOWED_HOSTS=api.your-domain.example
# Interface where the API port is published (keep 127.0.0.1 behind a reverse proxy on the same host).
API_BIND_ADDRESS=127.0.0.1

# ===== Optional: photo storage (default Local volume). S3-compatible: AWS S3, Cloudflare R2, MinIO =====
STORAGE_PROVIDER=Local
# STORAGE_S3_BUCKET=
# STORAGE_S3_SERVICE_URL=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# ===== Optional: customer notifications (None | Simulated | Twilio | Meta for WhatsApp, Smtp for email) =====
NOTIFICATIONS_WHATSAPP_PROVIDER=None
# META_PHONE_NUMBER_ID=
# META_ACCESS_TOKEN=
# META_TEMPLATE_NAME=
NOTIFICATIONS_EMAIL_PROVIDER=None
# SMTP_HOST=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# ===== Optional: AI repair suggestions with Claude (None | Anthropic) =====
AI_PROVIDER=None
# ANTHROPIC_API_KEY=

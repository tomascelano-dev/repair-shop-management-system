# Domain pointing to this server (A/AAAA record). Caddy obtains the HTTPS certificate automatically.
DOMAIN=app.tutaller.com.ar
ACME_EMAIL=tu-email@ejemplo.com

# Secrets: generate with `openssl rand -base64 48`
DB_PASSWORD=
JWT_KEY=

# Monthly prices in ARS
PRICE_BASIC=29900
PRICE_STANDARD=44900
PRICE_PRO=74900
TRIAL_DAYS=14

# Mercado Pago (Tus integraciones > Credenciales de producción; Webhooks > clave secreta)
BILLING_PROVIDER=MercadoPago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Electronic invoicing: Arca (each shop uploads its own certificate) or Simulated
FISCAL_PROVIDER=Arca

# Email (any SMTP provider: Amazon SES, Brevo, Mailgun, Google Workspace…)
MESSAGING_PROVIDER=Live
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=avisos@tutaller.com.ar

# SMS (Twilio-compatible API). Leave empty to disable SMS.
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# Backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=6
RCLONE_REMOTE=

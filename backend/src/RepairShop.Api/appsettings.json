{
  "ConnectionStrings": {
    "RepairShopDb": "Host=localhost;Port=5432;Database=repairshop;Username=postgres;Password=__CHANGE_ME__"
  },
  "Jwt": {
    "Issuer": "RepairShop",
    "Audience": "RepairShop",
    "Key": "__SET_VIA_ENV_OR_SECRETS__",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "RefreshCookie": {
      "Name": "rs_refresh",
      "SameSite": "Strict"
    }
  },
  "App": {
    "FrontendBaseUrl": "http://localhost:5173",
    "PublicApiUrl": "http://localhost:8080"
  },
  "ReverseProxy": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "RateLimiting": {
    "AuthPerMinute": 20,
    "PublicPerMinute": 60,
    "WebhooksPerMinute": 300
  },
  "Security": {
    "Login": {
      "RateLimit": {
        "PermitLimit": 10,
        "WindowSeconds": 60
      },
      "Lockout": {
        "MaxFailedAttempts": 5,
        "CooldownSeconds": 600,
        "FailureResetSeconds": 900
      }
    }
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "Enabled": false
  },
  "OpenTelemetry": {
    "Enabled": false,
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({CorrelationId}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "data/uploads"
    },
    "S3": {
      "Bucket": "",
      "ServiceUrl": "",
      "Region": "auto",
      "AccessKey": "",
      "SecretKey": "",
      "ForcePathStyle": true,
      "KeyPrefix": ""
    }
  },
  "Notifications": {
    "DispatcherEnabled": true,
    "PollSeconds": 10,
    "BatchSize": 20,
    "WhatsApp": {
      "Provider": "None"
    },
    "Sms": {
      "Provider": "None"
    },
    "Email": {
      "Provider": "None"
    },
    "Twilio": {
      "AccountSid": "",
      "AuthToken": "",
      "WhatsAppFrom": "",
      "SmsFrom": ""
    },
    "Meta": {
      "PhoneNumberId": "",
      "AccessToken": "",
      "ApiVersion": "v21.0",
      "TemplateName": "",
      "TemplateLanguage": "es_AR"
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "RepairShop",
      "Security": "Auto"
    }
  },
  "Jobs": {
    "Enabled": true,
    "RemindersIntervalMinutes": 60,
    "QuoteExpiryIntervalMinutes": 30,
    "ExchangeRatesIntervalMinutes": 360,
    "CleanupIntervalMinutes": 720
  },
  "ExchangeRates": {
    "Provider": "DolarApi"
  },
  "Ai": {
    "Provider": "None",
    "Anthropic": {
      "ApiKey": "",
      "Model": "claude-opus-5-5",
      "Effort": "medium",
      "MaxTokens": 16000,
      "TimeoutSeconds": 90,
      "UseServerSideFallback": true
    }
  },
  "DataProtection": {
    "MasterKey": ""
  }
}

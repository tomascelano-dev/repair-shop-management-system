# Production example.
#
# Recommended: serve the SPA and the API on the same site (reverse proxy /api -> backend) and keep the default /api/v1.
# The session refresh token is an httpOnly cookie scoped to /api/v1/auth.
#
# If the API lives on another origin, set it here and allow the SPA origin on the backend:
#   Cors__AllowedOrigins__0=https://app.tu-dominio.com
# Subdomains of the same site (app.tu-dominio.com + api.tu-dominio.com) work with the default SameSite=Strict cookie.
# Completely different sites need: Auth__RefreshCookie__SameSite=None (HTTPS only).
VITE_API_BASE=https://api.tu-dominio.com/api/v1

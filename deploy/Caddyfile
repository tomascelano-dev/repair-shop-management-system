{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}

	# The tracking widget is embedded in other sites.
	@widget path /widget.js
	header @widget Access-Control-Allow-Origin "*"

	handle {
		root * /srv
		# The seguimiento page is embeddable in an iframe; everything else is not.
		@notEmbed not path /seguimiento/*
		header @notEmbed X-Frame-Options "DENY"
		@sw path /sw.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
